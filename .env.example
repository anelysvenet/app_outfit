# Clé API Anthropic — requise pour l'analyse des vêtements et la génération de tenues
ANTHROPIC_API_KEY=sk-ant-...

# Base de données Postgres (intégration Neon sur Vercel) — requise en production.
# Injectée automatiquement par Vercel quand vous connectez une base Neon/Postgres.
DATABASE_URL=postgres://...

# Stockage des images (Vercel Blob) — requis en production.
# Injecté automatiquement par Vercel quand vous créez un store Blob.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Secret de signature des sessions — À DÉFINIR en production (chaîne aléatoire longue).
# Générez-en un avec : openssl rand -hex 32
AUTH_SECRET=

# Optionnel — essayage virtuel réaliste via fal.ai (modèle IDM-VTON)
# Sans cette clé, l'app affiche un rendu "lookbook" élégant à la place.
FAL_KEY=
