# Clé API Anthropic — requise pour l'analyse des vêtements et la génération de tenues
ANTHROPIC_API_KEY=sk-ant-...

# Base de données Postgres (intégration Neon sur Vercel) — requise en production.
# Injectée automatiquement par Vercel quand vous connectez une base Neon/Postgres.
DATABASE_URL=postgres://...

# Stockage des images (Vercel Blob) — requis en production.
# Injecté automatiquement par Vercel quand vous créez un store Blob.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Secret de signature des sessions — À DÉFINIR en production (chaîne aléatoire longue).
# Générez-en un avec : openssl rand -hex 32
AUTH_SECRET=

# Optionnel — essayage virtuel réaliste via fal.ai.
# Vêtements : modèle FASHN. Chaussures + accessoires : modèle d'édition d'image.
# Sans cette clé, l'app affiche un rendu "lookbook" élégant à la place.
FAL_KEY=

# Optionnel — active l'essayage des chaussures + accessoires (lunettes, chapeau,
# bijoux, sac…) via un modèle d'édition d'image. DÉSACTIVÉ par défaut car facturé
# à l'usage sur la même clé fal.ai. Mettre 1 (ou true/on) pour l'activer.
FAL_ACCESSORIES=

# Optionnel — modèle d'édition utilisé pour AJOUTER les accessoires/chaussures
# sur la silhouette. Défaut : fal-ai/nano-banana/edit. Pour plus de qualité sur
# les cas difficiles, essayez : fal-ai/nano-banana-pro/edit
FAL_EDIT_MODEL=
